{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Deliberately narrower than the root config: the daemon is a plain GJS
    // process, so importing St, Clutter or any `resource:///org/gnome/shell`
    // module must fail to typecheck rather than fail at runtime.
    "paths": {
      "gi://GLib": ["node_modules/@girs/glib-2.0/glib-2.0-ambient"],
      "gi://Gio": ["node_modules/@girs/gio-2.0/gio-2.0-ambient"],
      "gi://GObject": ["node_modules/@girs/gobject-2.0/gobject-2.0-ambient"]
    }
  },
  "include": ["src/daemon/**/*", "src/shared/**/*"]
}
